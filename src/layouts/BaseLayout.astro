---
import "../styles/global.css";

/*
 * =========================================
 * FONTES
 * =========================================
 *
 * Só o subconjunto latin em woff2. Os CSS do
 * @fontsource declaram 28 @font-face (cyrillic,
 * vietnamese, latin-ext, fallback .woff) que
 * iam inline no HTML sem nunca serem usados —
 * todo o texto do site cabe em U+0000–00FF.
 */
import cormorant300Url from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url";
import cormorant400Url from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url";
import italianno400Url from "@fontsource/italianno/files/italianno-latin-400-normal.woff2?url";
import montserrat300Url from "@fontsource/montserrat/files/montserrat-latin-300-normal.woff2?url";
import montserrat400Url from "@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url";
import montserrat500Url from "@fontsource/montserrat/files/montserrat-latin-500-normal.woff2?url";

const fontFaces = [
  ["Cormorant Garamond", 300, cormorant300Url],
  ["Cormorant Garamond", 400, cormorant400Url],
  ["Italianno", 400, italianno400Url],
  ["Montserrat", 300, montserrat300Url],
  ["Montserrat", 400, montserrat400Url],
  ["Montserrat", 500, montserrat500Url],
];

const fontFaceCss = fontFaces
  .map(
    ([family, weight, url]) =>
      `@font-face{font-family:"${family}";font-style:normal;font-display:swap;font-weight:${weight};src:url(${url}) format("woff2")}`
  )
  .join("");

interface Props {
  title?: string;
  description?: string;
  preloadIntroFonts?: boolean;
}

const {
  title = "Sthefani Pozzer | Fotografia",
  description =
    "Fotografia autoral, editorial e experiências visuais construídas com intenção.",
  preloadIntroFonts = false,
} = Astro.props;

/*
 * A entrada do Hero aguarda essas três fontes
 * (introExperience.js). Pré-carregar evita que
 * o download só comece após o parse do CSS.
 */
const introFonts = preloadIntroFonts
  ? [cormorant300Url, italianno400Url, montserrat300Url]
  : [];
---

<!doctype html>

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <style is:inline set:html={fontFaceCss}></style>

    {
      introFonts.map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin
        />
      ))
    }

    <!-- =========================================
         GOOGLE TAG MANAGER
         ========================================= -->

    <!--
      O dataLayer e o gtm.start nascem no início
      (o tempo da página continua correto), mas o
      gtm.js — que puxa o Pixel do Facebook, ~250 KB
      de JS — só é injetado depois do load, no
      primeiro momento ocioso. Assim ele não disputa
      o main thread com a entrada do Hero.
    -->
    <script is:inline>
      (function(w,d,s,l,i){
        w[l]=w[l]||[];

        w[l].push({
          "gtm.start": new Date().getTime(),
          event: "gtm.js"
        });

        function inject(){
          var f=d.getElementsByTagName(s)[0],
              j=d.createElement(s),
              dl=l!="dataLayer" ? "&l="+l : "";

          j.async=true;

          j.src=
            "https://www.googletagmanager.com/gtm.js?id="+i+dl;

          f.parentNode.insertBefore(j,f);
        }

        function schedule(){
          if ("requestIdleCallback" in w) {
            w.requestIdleCallback(inject, { timeout: 2000 });
          } else {
            w.setTimeout(inject, 0);
          }
        }

        if (d.readyState === "complete") {
          schedule();
        } else {
          w.addEventListener("load", schedule, { once: true });
        }

      })(window,document,"script","dataLayer","GTM-PLDHFWZ2");
    </script>

    <!-- End Google Tag Manager -->


    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#090909"
    />


    <!-- =========================================
         BOOT GUARD
         ========================================= -->

    <script is:inline>
      (() => {
        const root =
          document.documentElement;

        root.classList.add(
          "js"
        );

        window.__BYSP_BOOT_FALLBACK__ =
          window.setTimeout(
            () => {
              root.classList.add(
                "js-fallback"
              );
            },
            3500
          );
      })();
    </script>

    <title>
      {title}
    </title>
  </head>


  <body>
    <!-- =========================================
         GOOGLE TAG MANAGER — NOSCRIPT
         ========================================= -->

    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PLDHFWZ2"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>

    <!-- End Google Tag Manager -->


    <slot />

    <!-- =========================================
         AVISO DE COOKIES
         ========================================= -->

    <p class="privacy-notice">
      Este site utiliza cookies para melhorar sua experiência e analisar a navegação.
    </p>
  </body>
</html>

<style>
  .privacy-notice {
    width: 100%;
    max-width: none;

    margin: 0;

    padding: 1.25rem var(--page-inline, 1.5rem)
      calc(1.5rem + var(--safe-bottom));

    color: rgba(42, 42, 42, 0.5);

    font-family: var(--font-sans);

    font-size: 0.62rem;

    line-height: 1.6;

    text-align: center;

    background: var(--color-light);
  }
</style>