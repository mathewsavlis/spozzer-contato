---
import { portfolioData } from "../data/portfolioData.js";
import { assetPath, assetSize, assetSrcset } from "../lib/assets.js";

/*
 * Largura renderizada no pior caso, já considerando
 * o recorte do object-fit: cover nas células altas.
 * Desktop: 4 colunas, células altas de até 44vw.
 *
 * Celular (≤419px): as células têm 188–235px, mas
 * declaramos 160px de propósito — em telas 3x isso
 * pede a variante de 480w (densidade ~2x) em vez da
 * de 800w: −55% de bytes sem perda visível.
 *
 * As fotos usam data-src (lib/deferredImages.js):
 * o grid fica atrás do Hero e só aparece depois de
 * ~1 tela de scroll, então elas só começam a baixar
 * quando o JS da Intro já rodou. Medido em celular
 * com 4G lento: o texto do Hero aparece ~450 ms
 * antes e o LCP cai ~380 ms.
 */
const imageSizes =
  "(min-width: 48rem) 30vw, (max-width: 419px) 160px, 60vw";

/*
 * Célula de cada foto vem de portfolioData.js
 * ([coluna, linha, quantas linhas]) e entra como
 * variáveis CSS — o media query escolhe qual usar.
 * grid-area: linha-início / coluna-início / linha-fim.
 */
const cell = ([column, row, span]) =>
  `${row} / ${column} / span ${span}`;
---

<section
  id="portfolio"
  class="portfolio-stage"
  data-portfolio-stage
  aria-labelledby="portfolio-grid-title"
>
  <h2 id="portfolio-grid-title" class="visually-hidden">
    Portfólio fotográfico
  </h2>

  <div class="portfolio-viewport" data-portfolio-viewport>
    <div class="portfolio-grid" data-portfolio-grid>
      {
        portfolioData.items.map((item) => {
          const { width, height } = assetSize(item.image);
          const src = assetPath(item.image);
          const srcset = assetSrcset(item.image);
          const style = item.position ? `object-position: ${item.position}` : undefined;

          return (
            <figure
              class="portfolio-grid__item"
              style={`--cell-mobile: ${cell(item.mobile)}; --cell-desktop: ${cell(item.desktop)};`}
            >
              <img
                class="portfolio-grid__image"
                data-src={src}
                data-srcset={srcset}
                sizes={imageSizes}
                alt={item.title}
                width={width}
                height={height}
                style={style}
                decoding="async"
              />
              <noscript>
                <img
                  class="portfolio-grid__image"
                  src={src}
                  srcset={srcset}
                  sizes={imageSizes}
                  alt={item.title}
                  width={width}
                  height={height}
                  style={style}
                  loading="lazy"
                  decoding="async"
                />
              </noscript>
            </figure>
          );
        })
      }
    </div>

  </div>
</section>

<style>
  .portfolio-stage {
    position: relative;
    width: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-deep);
    color: var(--color-light);
  }

  .portfolio-viewport {
    position: relative;
    width: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-deep);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: clamp(11rem, 42vw, 17rem);
    width: 100%;
    min-width: 0;
    background: var(--color-deep);
  }

  .portfolio-grid__item {
    position: relative;
    grid-area: var(--cell-mobile);
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #111;
  }

  .portfolio-grid__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: translateZ(0);
  }



  /*
   * No modo enhanced o painel continua com a geometria estável da Intro.
   * Apenas a superfície visual cobre 100dvh para não expor uma faixa
   * quando as barras do Safari aparecem/desaparecem.
   */
  .portfolio-stage.is-enhanced {
    height: var(--intro-canvas-height, 100%);
    min-height: 0;
    overflow: visible;
    contain: layout;
    isolation: isolate;
  }

  .portfolio-stage.is-enhanced .portfolio-viewport {
    position: absolute;
    inset: 0;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    background: var(--color-deep);
  }

  .portfolio-stage.is-enhanced .portfolio-grid {
    will-change: transform;
  }

  @media (min-width: 48rem) {
    .portfolio-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(13rem, 22vw, 25rem);
    }

    .portfolio-grid__item {
      grid-area: var(--cell-desktop);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-stage.is-enhanced .portfolio-grid {
      will-change: auto;
    }
  }
</style>
