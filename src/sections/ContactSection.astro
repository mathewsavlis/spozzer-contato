---
import { contactData } from "../data/contactData.js";
import {
  WHATSAPP_MESSAGE,
  buildWhatsappUrl,
} from "../lib/leads/whatsappLead.js";

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? "";

const whatsappUrl = buildWhatsappUrl(whatsappNumber, WHATSAPP_MESSAGE);
---

<section
  id="contato"
  class="contact"
  data-contact
  aria-labelledby="contact-title"
>
  <div class="contact__container">
    <header class="contact__header">
      <p class="contact__eyebrow type-eyebrow">
        {contactData.eyebrow}
      </p>

      <!--
        Mesma composição do título do Hero:
        primeira linha display, segunda linha
        com a palavra em script + display.
      -->
      <h2 id="contact-title" class="contact__title">
        <span class="contact__title-line type-display">
          {contactData.title.firstLine}
        </span>

        <span class="contact__title-line contact__title-line--accent">
          <span class="contact__title-signature type-script">
            {contactData.title.accent}
          </span>

          <span class="type-display">
            {contactData.title.secondLine}
          </span>
        </span>
      </h2>

      <p class="contact__description type-body">
        {contactData.description}
      </p>
    </header>

    <div class="contact-cta" data-contact-cta>
      <!--
        O link já sai pronto do build. No clique,
        contactExperience.js só grava o lead — a
        mensagem que a pessoa envia não muda.
      -->
      <a
        class="contact-cta__button"
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        data-whatsapp-cta
        data-whatsapp-number={whatsappNumber}
      >
        {contactData.ctaLabel}
      </a>

      <p class="contact-cta__note">
        {contactData.ctaNote}
      </p>
    </div>
  </div>
</section>

<style>
  /* =========================================
     SECTION
     ========================================= */

  .contact {
    position: relative;

    display: flex;

    width: 100%;
    max-width: 100%;

    min-height: var(--contact-stable-height, 100svh);

    align-items: center;

    padding: clamp(2.25rem, 6svh, 3.5rem) var(--page-inline)
      calc(clamp(1.75rem, 4svh, 2.75rem) + var(--safe-bottom));

    overflow: hidden;

    background: linear-gradient(
      to bottom,
      #eae6df 0%,
      var(--color-light) 16%,
      var(--color-light) 100%
    );

    color: var(--color-dark);
  }

  /*
   * Composição centralizada, como o Hero e a
   * introdução do Portfolio: sem formulário,
   * a seção vira um único bloco de leitura
   * que termina no botão.
   */
  .contact__container {
    display: grid;

    width: 100%;
    max-width: 48rem;

    min-width: 0;

    justify-items: center;

    margin-inline: auto;

    gap: clamp(2.5rem, 6svh, 3.25rem);

    text-align: center;
  }

  /* =========================================
     HEADER
     ========================================= */

  .contact__header {
    display: grid;

    width: 100%;
    min-width: 0;

    justify-items: center;
  }

  .contact__eyebrow {
    margin-bottom: 1.6rem;

    color: var(--color-gold);

    letter-spacing: 0.32em;
  }

  .contact__title {
    display: grid;

    max-width: 100%;

    place-items: center;

    gap: 0.4rem;

    color: var(--color-dark);
  }

  .contact__title-line {
    display: block;

    max-width: 100%;

    font-size: clamp(2.3rem, 10.4vw, 3.3rem);

    line-height: 0.9;

    word-spacing: -0.06em;

    white-space: nowrap;
  }

  .contact__title-line--accent {
    display: flex;

    align-items: baseline;

    justify-content: center;

    gap: 0.22em;
  }

  /*
   * Mesmo ajuste do Hero: o padding mantém a
   * cauda da letra script dentro da caixa —
   * o reveal anima clip-path no título.
   */
  .contact__title-signature {
    position: relative;
    top: 0.04em;

    display: inline-block;

    padding-bottom: 0.28em;
    margin-bottom: -0.28em;

    color: var(--color-gold);

    font-size: 1.22em;

    line-height: 1;
  }

  .contact__description {
    width: calc(100% - (var(--copy-gutter) * 2));

    max-width: 25rem;

    margin-top: 2rem;

    color: rgba(42, 42, 42, 0.66);

    font-size: clamp(0.74rem, 2.7vw, 0.86rem);

    line-height: 1.9;

    letter-spacing: 0.012em;

    text-wrap: pretty;
  }

  /* =========================================
     CTA
     =========================================
     Mesmo botão do Hero ("AGENDAR SESSÃO"),
     invertido para o fundo claro.
     ========================================= */

  .contact-cta {
    display: grid;

    width: 100%;
    min-width: 0;

    justify-items: center;

    gap: 1.1rem;
  }

  .contact-cta__button {
    display: inline-flex;

    max-width: 100%;
    min-height: 3.25rem;

    align-items: center;
    justify-content: center;

    padding: 1.05rem clamp(1.4rem, 6vw, 2.75rem);

    border: 1px solid rgba(42, 42, 42, 0.45);

    background: transparent;

    color: var(--color-dark);

    font-family: var(--font-sans);

    font-size: 0.625rem;

    font-weight: 500;

    line-height: 1;

    letter-spacing: 0.22em;

    text-align: center;

    text-decoration: none;

    text-transform: uppercase;

    white-space: nowrap;

    transition:
      background-color var(--duration-normal) var(--ease-premium),
      border-color var(--duration-normal) var(--ease-premium),
      color var(--duration-normal) var(--ease-premium);
  }

  .contact-cta__button:focus-visible {
    border-color: var(--color-dark);

    background: var(--color-dark);

    color: var(--color-light);

    outline: 2px solid var(--color-gold);

    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-cta__button:hover {
      border-color: var(--color-dark);

      background: var(--color-dark);

      color: var(--color-light);
    }
  }

  .contact-cta__note {
    color: rgba(42, 42, 42, 0.46);

    font-family: var(--font-sans);

    font-size: 0.56rem;

    font-weight: 500;

    letter-spacing: 0.2em;

    text-transform: uppercase;
  }

  /* =========================================
     DESKTOP
     ========================================= */

  @media (min-width: 48rem) {
    .contact {
      min-height: 100dvh;

      padding: clamp(3.5rem, 7dvh, 5.5rem) var(--page-inline);
    }

    .contact__container {
      max-width: 60rem;

      gap: clamp(2.75rem, 6dvh, 3.75rem);
    }

    .contact__eyebrow {
      margin-bottom: 2rem;
    }

    .contact__title {
      gap: clamp(0.5rem, 1vh, 0.75rem);
    }

    .contact__title-line {
      font-size: clamp(3.8rem, 4.7vw, 5.35rem);
    }

    .contact__title-signature {
      top: 0.025em;

      padding-bottom: 0.3em;
      margin-bottom: -0.3em;
    }

    .contact__description {
      max-width: 33rem;

      margin-top: 2.35rem;

      font-size: clamp(0.8rem, 0.9vw, 0.9rem);

      line-height: 1.95;
    }

    .contact-cta__button {
      padding-inline: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-cta__button {
      transition: none;
    }
  }
</style>
